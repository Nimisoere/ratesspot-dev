    "start": "node src/server.ts",
    "typecheck": "tsc -p tsconfig.json"
  },
  "devDependencies": {
    "@types/node": "26.6.6"
  },
  "exports": {
    ".": "./src/tools.ts"
  },
  "dependencies": {
    "@modelcontextprotocol/server": "2.4.0",
    "openapi-fetch": "0.17.0",
    "zod": "4.6.7"
  }
